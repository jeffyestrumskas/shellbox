# shellbox default secrets TEMPLATE for Hermes Agent -> rendered to ~/.hermes/.env.
# Contains ONLY ${...} placeholders (no real secrets); they are substituted from
# the container's environment by shellbox on first run, and the rendered .env
# lands in the host state mount (~/.shellbox/agents/hermes/), never in this repo.
# An already-rendered .env is never overwritten.
#
# The custom (Ollama Cloud) provider reads its key from OPENAI_API_KEY; we also
# export OLLAMA_API_KEY for parity with the Ollama tooling.
OLLAMA_API_KEY=${OLLAMA_API_KEY}
OPENAI_API_KEY=${OLLAMA_API_KEY}
