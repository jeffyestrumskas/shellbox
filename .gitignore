# Default-deny: ignore EVERYTHING, then un-ignore only the canonical scripts,
# their READMEs, and this file. Anything not whitelisted below — diagnostics
# (e.g. boxwall-diag.sh), scratch files, local rule state (.shellbox/), secrets,
# env files, caches — stays out of the repo by default. To track a new file, add
# an explicit `!`-rule for it here.
/*

!/.gitignore
!/README.md
!/shellbox.sh

# boxwall/ — keep only the script + its README (drops boxwall-diag.sh etc.)
!/boxwall/
/boxwall/*
!/boxwall/README.md
!/boxwall/boxwall.sh

# boxwatch/ — keep only the script + its README
!/boxwatch/
/boxwatch/*
!/boxwatch/README.md
!/boxwatch/boxwatch.sh

# agents/ — config templates for shellbox.sh --agent (keep README + per-agent configs)
!/agents/
/agents/*
!/agents/README.md
!/agents/openclaw/
/agents/openclaw/*
!/agents/openclaw/config.json5
!/agents/hermes/
/agents/hermes/*
!/agents/hermes/config.yaml
!/agents/hermes/env.template

# Defense-in-depth: never commit a real secret/env file, even if a future
# whitelist above would include it. Config TEMPLATES use a *.template name and
# are whitelisted explicitly; live secrets render to ~/.shellbox (outside the repo).
**/.env
**/.env.*
**/*.env
